# ── Payment providers ────────────────────────────────────────────────
# Both providers are optional — the checkout page auto-detects which
# ones are configured and only offers those. Restart the dev server
# after changing these.

# Stripe (test mode): https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_your_key_here

# Razorpay (test mode): https://dashboard.razorpay.com → Settings → API Keys
# → Generate Test Key. BOTH values are required for Razorpay checkout.
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# ── Admin dashboard (/admin) ─────────────────────────────────────────
# Password for the admin dashboard at /admin.
# If unset, the dev fallback password is: novathreads-admin
# Login is rate-limited (8 attempts / 15 min) to block brute force.
ADMIN_PASSWORD=change_me_admin_password

# Optional role for section access:
#   super    → everything (default)
#   products → products + inventory
#   orders   → orders + shipping
#   support  → customers + orders
# ADMIN_ROLE=super

# ── Order notifications (optional — email alone is enough) ──────────
# Email via Resend — free tier. Get an API key at resend.com/api-keys.
# Until you add your own domain, emails come from their test sender.
# Test it after setup: log in at /admin, then open /api/notify/test
RESEND_API_KEY=your_resend_api_key
ADMIN_EMAIL=you@example.com
# Optional custom sender once you verify a domain at resend.com/domains:
# EMAIL_FROM=Nova Threads <orders@yourdomain.com>

# Optional WhatsApp alerts via CallMeBot (skip entirely if you only
# want email — just leave both values blank / commented out).
# ADMIN_WHATSAPP_NUMBER=your_number_digits_only
# CALLMEBOT_APIKEY=your_callmebot_apikey

# ── Site ─────────────────────────────────────────────────────────────
# Optional: base URL used when returning from payment provider redirects
# and in notification emails. Defaults to http://localhost:3000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
